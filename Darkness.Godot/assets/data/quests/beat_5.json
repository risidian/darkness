      "Visuals": {
        "BackgroundKey": "dark_castle",
        "GroundColor": "#4a4438",
        "Npc": {
          "Name": "Risidian",
          "SpriteKey": "bosses/Risidian",
          "PositionX": 620,
          "PositionY": 260
        }
      },
      "Dialogue": {
        "Speaker": "Risidian",
        "Lines": [
          "Enough. You have earned a truth, if not my aid.",
          "What you hunt is no knight. It is older than the tower it sits in, and it knows your face, {playerName}.",
          "Go north. And do try to be worth the trouble you have cost me."
        ]
