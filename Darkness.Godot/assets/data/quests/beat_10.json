        "PlayerPositionX": 200,
        "PlayerPositionY": 560
      },
      "Dialogue": {
        "Speaker": "Narrator",
        "Lines": [
          "The plain before the tower is not empty. It is standing.",
          "Skeletons in rusted mail. Bloated dead that were farmers a season ago. Row upon row, and at their head, a crown of bone.",
          "This is the dominion Daverak promised. This is who keeps it."
        ]
      }
    },
    {
      "Id": "beat_10_kyarias",
      "Type": "dialogue",
      "NextStepId": "beat_10_party",
      "Visuals": {
