          "SpriteKey": "bosses/KazarthEndGame",
          "PositionX": 640,
          "PositionY": 220
        }
      },
      "Dialogue": {
        "Speaker": "Kyarias",
        "Lines": [
          "The little ant has reached the throne. All games end.",
          "I am Kyarias. My lord Daverak keeps the tower; I keep the ground before it, and everything under it.",
          "Every soul that falls joins my ranks. Yours will make fine additions."
        ]
      }
    },
