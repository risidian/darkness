      "Type": "dialogue",
      "AutoTransition": false,
      "NextStepId": "beat_8_choice",
      "Visuals": {
        "BackgroundKey": "road",
        "GroundColor": "#555555",
        "Npc": {
          "Name": "Tywin",
          "SpriteKey": "bosses/Tywin",
          "PositionX": 620,
          "PositionY": 300
        }
      },
      "Dialogue": {
        "Speaker": "Tywin",
        "Lines": [
          "Halt. These cliffs swallow strangers.",
          "Prove you're not one more thing crawling out of the thin places.",
          "Tywin of the Round Table. Sixteen years and still breathing, which out here is a boast. Draw, or turn back."
        ]
      }
    },
    {
      "Id": "beat_8_choice",
      "Type": "branch",
      "AutoTransition": false,
      "Visuals": {
        "BackgroundKey": "road",
        "GroundColor": "#555555",
        "Npc": {
          "Name": "Tywin",
          "SpriteKey": "bosses/Tywin",
          "PositionX": 620,
          "PositionY": 300
        }
      },
      "Dialogue": {
        "Speaker": "Tywin",
        "Lines": [
          "Well? Words or steel, {playerName}?"
        ]
      },
      "Branch": {
        "Options": [
          {
            "Text": "We're no shadow. But if a blade is the only word you trust - so be it.",
            "NextStepId": "beat_8_words",
            "MoralityImpact": 5
          },
          {
            "Text": "Stand aside or be moved.",
            "NextStepId": "beat_8_steel",
            "MoralityImpact": -5
          }
        ]
      }
    },
    {
      "Id": "beat_8_words",
      "Type": "dialogue",
      "NextStepId": "beat_8_combat",
      "Visuals": {
        "BackgroundKey": "road",
        "GroundColor": "#555555",
        "Npc": {
          "Name": "Tywin",
          "SpriteKey": "bosses/Tywin",
          "PositionX": 620,
          "PositionY": 300
        }
      },
      "Dialogue": {
        "Speaker": "Tywin",
        "Lines": [
          "Honest. I like honest.",
          "But the fog wears honest faces too. So - forgive me.",
          "One pass. Show me. Then we'll talk like men."
        ]
      }
    },
    {
      "Id": "beat_8_steel",
      "Type": "dialogue",
      "NextStepId": "beat_8_combat",
      "Visuals": {
        "BackgroundKey": "road",
        "GroundColor": "#555555",
        "Npc": {
          "Name": "Tywin",
          "SpriteKey": "bosses/Tywin",
          "PositionX": 620,
          "PositionY": 300
        }
      },
      "Dialogue": {
        "Speaker": "Tywin",
        "Lines": [
          "Moved. He says.",
          "By all means. Try.",
          "Rapier's already out, my good sir."
        ]
      }
    },
    {
